@startuml

class Cliente {
  - nombre: String
  - direccion: String
  - telefono: String
  - pinTarjeta: String
  - edad: Double
  # idInterno: int
  + registrarDatos(): void
  + solicitarReserva(): void
}

class ClientePreferencial {
  - descuentoPreferencial: double
}

class ClienteCorporativo {
  - volumenReservas: int
  + calcularDescuentoCorporativo(): double
}

class Reserva {
  - idReserva: int
  - estado: String
  - fecha: Date
  + calcularPrecio(): double
  + confirmarReserva(): boolean
}

class Agenda {
  - localidadesLibres: int
  + comprobarDisponibilidad(): boolean
}

Cliente <|-- ClientePreferencial
Cliente <|-- ClienteCorporativo
Cliente "1" --o "*" Reserva
Reserva "1" -- "1" Agenda
@enduml